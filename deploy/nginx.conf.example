# R-PROXY example. Install the frontend bundle at /var/www/filebox/dist or
# change root below. Configure FileBox with --trusted-proxies=127.0.0.1/32.

server {
    listen 80;
    server_name filebox.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name filebox.example.com;

    # Replace these placeholders with a certificate issued for this host.
    ssl_certificate /etc/letsencrypt/live/filebox.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/filebox.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/filebox/dist;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 600s;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
    }

    location /brand/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
}
